# Copy to .env and fill real values for production.
# Dummy AWS keys are fine for local — StorageService falls back to ./uploads.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/backendgymmast

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRATION=365d

FRONTEND_URL=http://localhost:3000
MARKETING_URL=http://localhost:3001
CRM_PUBLIC_URL=http://localhost:3000

# Transactional email (optional locally — logs preview if SMTP_HOST empty)
MAIL_FROM=GymFlow <noreply@gymflow.local>
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Branding / asset storage (S3 only — no local fallback)
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=gym-crm
S3_PUBLIC_BASE_URL=https://gym-crm.s3.ap-south-1.amazonaws.com

# ─── Razorpay (per-gym OAuth / Autopay) ───────────────────────
# Encrypt tokens at rest (any long secret)
PAYMENT_TOKEN_ENCRYPTION_KEY=change-me-payment-token-key
# Technology Partner OAuth (optional until approved)
RAZORPAY_PARTNER_CLIENT_ID=
RAZORPAY_PARTNER_CLIENT_SECRET=
RAZORPAY_PARTNER_REDIRECT_URI=http://localhost:5000/payment-provider/razorpay/callback
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SKIP_WEBHOOK_VERIFY=true
RAZORPAY_ALLOW_MOCK=true
BACKEND_PUBLIC_URL=http://localhost:5000
AUTOPAY_WORKER_ENABLED=true

# WhatsApp — payment links are AUTO-SENT to the member phone saved in CRM.
# Local/dev: WHATSAPP_ALLOW_MOCK=true (default with RAZORPAY_ALLOW_MOCK).
# Production: set Cloud API below OR connect in Settings → WhatsApp.
WHATSAPP_ALLOW_MOCK=true
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PAYMENT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en