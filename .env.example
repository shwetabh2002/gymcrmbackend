PORT=3000
NODE_ENV=development

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/backendgym

# JWT
JWT_ACCESS_SECRET=your-access-secret-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRATION=7d

# Employee Section Password
EMPLOYEE_SECTION_PASSWORD=your-employee-section-password

# Frontend URL (for CORS)
# For local development: http://localhost:3001
# For production: https://your-frontend-domain.com (e.g., https://yourapp.vercel.app or https://yourapp.netlify.app)
FRONTEND_URL=http://localhost:3001
