# Copy to .env and fill real values. NEVER commit .env.
# All secrets come from environment variables only.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/backendgymmast

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=365d

FRONTEND_URL=http://localhost:3000
MARKETING_URL=http://localhost:3000
CRM_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000

# Platform admin seeder (required for npm run seed)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Transactional email (optional locally — logs only if SMTP_HOST empty)
MAIL_FROM=GymFlow <noreply@gymflow.local>
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Branding / asset storage (S3)
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Attendance / ESSL (optional)
ESSL_SYNC_SOURCE=
ESSL_SQL_HOST=
ESSL_SQL_PORT=
ESSL_SQL_DATABASE=
ESSL_SQL_USER=
ESSL_SQL_PASSWORD=
ESSL_SQL_REALTIME_ENABLED=false
ESSL_SQL_REALTIME_INTERVAL_SECONDS=30

# Razorpay — secrets only (tax %, sweep interval → platform-billing.config.ts)
PAYMENT_TOKEN_ENCRYPTION_KEY=change-me-payment-token-key
BACKEND_PUBLIC_URL=http://localhost:5000
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SKIP_WEBHOOK_VERIFY=false
RAZORPAY_ALLOW_MOCK=false
AUTOPAY_WORKER_ENABLED=true

# Your merchant account — gyms pay US (Dashboard → API keys)
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=

# Optional later: Razorpay Partner OAuth ("Connect with Razorpay" for gyms).
# Without these, gyms still connect via their own API keys in Settings.
# RAZORPAY_PARTNER_CLIENT_ID=
# RAZORPAY_PARTNER_CLIENT_SECRET=
# RAZORPAY_PARTNER_REDIRECT_URI=http://localhost:5000/payment-provider/razorpay/callback

# WhatsApp (optional — Cloud API for auto-send; else wa.me share)
WHATSAPP_ALLOW_MOCK=false
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PAYMENT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_GRAPH_API_VERSION=v19.0
# WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com

# Activity logs — overall backend master switch (default off).
# Per-gym still needs entitlement (plan/unlock) + activityLogsEnabled ON.
ACTIVITY_LOGS_ENABLED=false
