# Copy to `.env` and replace placeholders. Never commit `.env`.

PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas
MONGODB_URI=mongodb://localhost:27017/backendgym

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=365d

# Session (if used)
SESSION_SECRET=change-me-session-secret

# "Today" on Attendance + date part of each punch (IANA, e.g. Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Employee section (HR UI password in the frontend)
EMPLOYEE_SECTION_PASSWORD=change-me-employee-password

# CORS: FRONTEND_URL should match the browser origin (scheme + host + port)
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra origins (e.g. http://192.168.1.10:3000 for another machine)
# In development, private LAN origins are also allowed automatically.
ADDITIONAL_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# eSSL / eTimeTrackLite — SOAP GetTransactionsLog (POST /attendance/sync-essl)
# The Nest server calls this URL; it must be reachable from the machine running
# the backend (same LAN as the biometric PC, or VPN). Use the host:port shown
# in eTimeTrackLite (e.g. http://192.168.1.5:82/iclock/WebAPIService.asmx).
# Replace every sample value with your real install.
#
# Web UI (for comparison only): Device Log List is often
# /iclock/Manage/DeviceLogList.aspx?Device=...&FromDay=..&ToDay=..&Month=..&Year=..
# The CRM does not scrape that page; it uses WebAPIService.asmx. Use the same
# calendar range in sync as in the portal filter, and ESSL_SERIAL_NUMBER for the
# device row you care about (portal Device=0 may mean "all devices"; SOAP is one serial).
# -----------------------------------------------------------------------------
# Base URL only (no ?…); the app appends ?op=GetTransactionsLog for POST, matching Postman / vendor docs.
# Put the full URL with query here only if you need a custom query; then op is not auto-appended.
# ESSL_SOAP_NO_OP_QUERY=1
ESSL_WEB_API_URL=http://192.168.1.5:82/iclock/WebAPIService.asmx
ESSL_SERIAL_NUMBER=CEXJ191160629
# Often the same as eTimeTrack web login (e.g. essl / essl); must be allowed for Web API in some builds.
ESSL_API_USERNAME=essl
ESSL_API_PASSWORD=essl
# Often a filter flag; keep default unless your vendor doc says otherwise
ESSL_STR_DATA_LIST=4
# date | datetime | both — "both" sends all four date fields (some IIS eSSL builds need this).
# If response is Unathorised User, configure a Web API user in eTimeTrack (can differ from Main.aspx login).
ESSL_SOAP_DATE_FIELDS=date
# ESSL_SOAP_DATE_PLAIN=1

# -----------------------------------------------------------------------------
# eSSL SQL direct sync (recommended when SOAP is unauthorized)
# Set ESSL_SYNC_SOURCE=sql to pull from AttendanceData table.
# -----------------------------------------------------------------------------
# ESSL_SYNC_SOURCE=sql
# ESSL_SQL_HOST=122.176.29.92
# ESSL_SQL_PORT=1433
# ESSL_SQL_DATABASE=etimetracklite1
# ESSL_SQL_USER=essl
# ESSL_SQL_PASSWORD=essl
# Realtime incremental pull (new SNO rows only)
# ESSL_SQL_REALTIME_ENABLED=true
# ESSL_SQL_REALTIME_INTERVAL_SECONDS=30
