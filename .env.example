PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/backendgym

# JWT
JWT_ACCESS_SECRET=your-access-secret-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRATION=7d

# CORS — browser origin(s) of the Next app
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra origins
ADDITIONAL_CORS_ORIGINS=

# Admin seed credentials (used by `npm run seed`). Change the password after first login.
SEED_ADMIN_EMAIL=admin@backendgym.com
SEED_ADMIN_PASSWORD=change-me
